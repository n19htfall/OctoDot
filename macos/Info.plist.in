<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>OctoDotIME</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OctoDot</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSBackgroundOnly</key>
	<false/>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>InputMethodConnectionName</key>
	<string>@BUNDLE_ID@_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>OctoInputController</string>
	<key>OctoDotCore</key>
	<string>@CORE@</string>
	<key>TISInputSourceID</key>
	<string>@BUNDLE_ID@</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>tsInputMethodIconFileKey</key>
	<string>BadgeFilled.tiff</string>
	<!-- The icons are badges drawn like the system's own (make-icon.swift):
	     template images, which macOS tints for light and dark. macOS draws
	     its own sources' badges from their label (TISIconLabels) but only
	     theirs; the label is kept for any surface that does use it. The
	     menu bar shows the selected source outlined, the input menu filled.
	     The indicator at the caret on a switch draws the menu bar's image:
	     given an alternate or button icon as well, it drew nothing
	     (2026-11-08). It reads icons once per login, so a change to them
	     shows there only after logging in again. -->
	<key>TISIconIsTemplate</key>
	<true/>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
		<string>Latn</string>
	</array>
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>@BUNDLE_ID@.Hans</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>@BUNDLE_ID@.Hans</string>
				<key>TISIconLabels</key>
				<dict>
					<key>Primary</key>
					<string>千</string>
				</dict>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
				</array>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>BadgeOutlined.tiff</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>BadgeFilled.tiff</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smUnicodeScript</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>@BUNDLE_ID@.Hans</string>
		</array>
	</dict>
</dict>
</plist>
